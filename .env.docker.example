# Docker Compose 로컬 실행용 환경변수 예시.
# 실제 값은 .env.docker 에 넣는다 (git 미추적):  cp .env.docker.example .env.docker
# DATABASE_URL / PGSSL 은 docker-compose.yml 의 environment 에서 주입하므로 여기 없음.

# ── 인증 (NextAuth v5) ──
# 세션 서명 키. 없으면 auth() 호출이 런타임 크래시. 직접 생성: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth 클라이언트. 비워두면 로그인만 실패하고 나머지 페이지는 정상 동작한다
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 콜백 URL 기준 오리진. 로컬 compose 는 web 을 3100 으로 노출한다
AUTH_URL=http://localhost:3100
# 포트매핑/리버스프록시 뒤에서 Host 헤더를 신뢰
AUTH_TRUST_HOST=true
# 로그인 시 role=admin 으로 승격할 이메일 (쉼표 구분)
ADMIN_EMAILS=

# ── LLM · 임베딩 (Ollama) ──
# Ollama 서버 주소. 호스트에서 직접 돌릴 때의 예시값이며, 실제 값은 .env.docker 에 넣는다
OLLAMA_BASE_URL=http://host.docker.internal:11434
# 검토 생성 모델
OLLAMA_MODEL=qwen3:8b
# 임베딩 모델 — events.embedding 이 VECTOR(1024) 라 차원은 1024 고정
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_EMBED_DIM=1024
# GEMINI_API_KEY 는 설정하지 않는다 — 값이 있으면 Ollama 대신 Gemini 가 우선된다

# ── 메일 알림 (문의·피드백, 선택) ──
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── 네이버 뉴스 API (사건 자동 수집, 선택) ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 크론 엔드포인트 보호 토큰 (선택) ──
CRON_SECRET=

# ── 앱 공개 URL ──
NEXT_PUBLIC_APP_URL=http://localhost:3100
